<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.3</version>
        <relativePath/>
    </parent>

    <groupId>it.gruppobernardini</groupId>
    <artifactId>switch-mail</artifactId>
    <version>1.0.0</version>
    <name>SwitchMail</name>
    <description>Processa le mail di aggiornamento inviate da sistemi esterni e agisce verso BERLink</description>

    <properties>
        <java.version>17</java.version>
        <sqlite.version>3.45.3.0</sqlite.version>
        <greenmail.version>2.1.3</greenmail.version>
    </properties>

    <dependencies>
        <!-- Web + UI Thymeleaf -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>

        <!-- Health checks -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- JdbcTemplate + HikariCP. NIENTE ActiveJDBC: vedi IMPLEMENTATION_PLAN.md, sezione Stack. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>

        <!--
          Porta jakarta.mail + l'implementazione Angus con versione gestita dal parent.
          Nessuna property spring.mail.* e' configurata, quindi Spring non crea nessun
          JavaMailSender: di questa dipendenza si usa solo il client IMAP.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>

        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>${sqlite.version}</version>
        </dependency>

        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
          Server IMAP in-process per gli integration test. Linea 2.x obbligatoria:
          GreenMail 1.x e' javax.mail e non interopera con Boot 3 / jakarta.mail.
        -->
        <dependency>
            <groupId>com.icegreen</groupId>
            <artifactId>greenmail-junit5</artifactId>
            <version>${greenmail.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
              Gli *IT girano insieme agli unit test: sono in-process (GreenMail), durano pochi secondi
              e sono esattamente quelli che verificano la garanzia di non distruttivita'. Tenerli
              dietro a un profilo separato significherebbe non eseguirli mai.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <includes>
                        <include>**/*Test.java</include>
                        <include>**/*IT.java</include>
                    </includes>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <!--
                          build-info genera META-INF/build-info.properties, da cui Boot ricava il bean
                          BuildProperties: il campo "version" del contratto di health viene cosi' dal
                          build e non da una costante che qualcuno dimentichera' di aggiornare.
                        -->
                        <goals>
                            <goal>build-info</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
